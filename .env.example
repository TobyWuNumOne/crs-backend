# ===========================================
# Clinic Registration System - Backend Config
# ===========================================
# Copy this file to .env and modify as needed

# ----- Application Settings -----
DEVTEAM_PATH=.
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
RELOAD=True
WORKERS=1

# ----- Database Settings -----
# For Docker development environment (docker-compose.dev.yml)
POSTGRES_USER=devuser
POSTGRES_PASSWORD=devpass
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=clinic_dev

# For local development without Docker (直接連接本地 PostgreSQL)
# POSTGRES_SERVER=localhost
# POSTGRES_PORT=5432

# ----- API Settings -----
API_PREFIX=/api

# ----- JWT Authentication -----
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ----- Future Production Database -----
# Uncomment and configure when connecting to production database
# POSTGRES_USER=prod_user
# POSTGRES_PASSWORD=prod_secure_password
# POSTGRES_SERVER=your-production-db-host.com
# POSTGRES_PORT=5432
# POSTGRES_DB=clinic_prod

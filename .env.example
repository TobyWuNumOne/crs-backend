# Environment example file
# Copy to .env and fill with production-safe values

# Database
POSTGRES_USER=testuser
POSTGRES_PASSWORD=testpass
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=testdb

# API
API_PREFIX=/api

# JWT
JWT_SECRET_KEY=your-very-strong-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
